# =============================================================================
# tiger-go-demo — environment template
# =============================================================================
# Copy to .env, fill in, and `set -a; . ./.env; set +a` (or use your shell /
# direnv / systemd EnvironmentFile). .env is gitignored and must never be
# committed.
#
# Generate your credentials at the Tiger OpenAPI developer portal:
#     https://quant.itigerup.com/openapi/en/
#
# !! A Tiger SIMULATED account will NOT work against OpenAPI. You need a REAL,
# !! funded account with OpenAPI access enabled. See README "Requirements".
# =============================================================================

# --- Required ---------------------------------------------------------------

# Developer ID (sometimes called the App Key).
# Portal: My OpenAPI -> App management. This is a numeric id.
TIGER_ID=

# RSA private key used to SIGN every request. The portal generates this when
# you create an app; download it as a .pem file.
# It looks like:
#   -----BEGIN RSA PRIVATE KEY-----
#   MIIEowIBAAKCAQEA...
#   -----END RSA PRIVATE KEY-----
#
# Note: the SDK accepts PKCS#1 ("BEGIN RSA PRIVATE KEY") and PKCS#8
# ("BEGIN PRIVATE KEY") bodies.
TIGER_PRIVATE_KEY=

# Trading account number, e.g. DU1234567. Only strictly required for order
# operations (cmd/trade); the quote command does not need it.
TIGER_ACCOUNT=

# --- Recommended instead of inlining the key -------------------------------
# Put the private key in a file with mode 0600 and point at it. This keeps the
# secret out of your shell history and out of `ps` output.
# TIGER_PRIVATE_KEY_FILE=/home/you/.config/tiger/private_key.pem

# --- Institutional accounts only -------------------------------------------
# App Secret. Only needed for institutional / prime accounts whose trade
# requests must carry secret_key. Leave EMPTY for a normal retail account.
#
# WARNING: never send an empty secret_key in a request body — Tiger rejects it
# with biz_param_error(1010). This project omits the field entirely when unset.
TIGER_SECRET_KEY=

# --- Runtime ----------------------------------------------------------------

# Licence entity. One of: TBNZ (default), TBSG, TBAU, TBIH, TBHK.
# If you are unsure, leave the default; Tiger picks the right one from your
# developer id.
TIGER_LICENSE=TBNZ

# Response language: zh_CN, zh_TW or en_US.
TIGER_LANGUAGE=en_US

# Timezone used for timestamps in responses, e.g. US/Eastern, Asia/Hong_Kong.
TIGER_TIMEZONE=US/Eastern

# HTTP request timeout, Go duration syntax.
TIGER_TIMEOUT=15s

# Device identifier. Leave empty to let the SDK auto-detect the MAC address.
TIGER_DEVICE_ID=

# --- Endpoints (advanced; leave alone unless Tiger tells you otherwise) -----
# Default: https://openapi.tigerfintech.com/gateway
TIGER_SERVER_URL=
# Defaults to TIGER_SERVER_URL when empty.
TIGER_QUOTE_SERVER_URL=
# Push server, TCP + TLS.
TIGER_PUSH_URL=openapi.tigerfintech.com:8887

# =============================================================================
# SAFETY — read this before you touch anything below
# =============================================================================
# The dry-run gate is the ONLY thing standing between a typo and a real,
# live order on a real, funded account. Tiger has NO paper/simulated mode.
#
# true  (default) -> place/modify/cancel print what they WOULD send and exit 3.
# false           -> writes are actually sent, but STILL require --confirm-live.
#
# Keep this true unless you are deliberately placing a real order, and even
# then pass --confirm-live as well. Both must be satisfied; neither alone is
# enough.
TIGER_DRY_RUN=true

# Path to a YAML config file. Environment variables take precedence over it.
#TIGER_CONFIG=config.local.yaml

# Log level: debug, info, warn, error.
TIGER_LOG_LEVEL=info
