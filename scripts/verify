#!/bin/sh
# The verification gate for tiger-go-demo.
#
# This file is the gate, not `make`. The Makefile targets are a convenience
# layer over the same four commands, so the checks run on a machine with no
# GNU make installed — which is the point: a gate that only runs on one
# contributor's machine is not a gate.
#
#   1. gofmt        formatting, including line endings
#   2. go vet       the standard correctness checks
#   3. go test      the suite
#   4. coverage     the SDK coverage assertion (its own package, listed
#                   separately so its failure is unambiguous)
#
# The first failure exits non-zero. Every step must pass.
set -eu

GO="${GO:-go}"

# gofmt is checked with -l rather than run, because a gate that rewrites the
# tree cannot be a gate: a contributor running it to find out whether their
# commit is clean must not have it silently fixed first.
fmt=$("$GO" fmt ./... 2>/dev/null || true)
if [ -n "$fmt" ]; then
	echo "gofmt: these files were not formatted:"
	echo "$fmt"
	echo "fix with: $GO fmt ./..."
	exit 1
fi
echo "gofmt: clean"

"$GO" vet ./...

# -race needs cgo, which needs a C compiler. Go's Windows installer ships none,
# so a stock Windows box has to opt out. That is a missing toolchain, not a
# property of the platform: with a MinGW-w64 gcc on PATH the whole suite passes
# clean under -race on Windows, which is how this file was last run. Set
# TIGER_NO_RACE=1 (or use `make test-norace`) only on a machine with no C
# toolchain. The race detector is the better default, so skipping is the opt-out
# rather than the rule.
if [ "${TIGER_NO_RACE:-0}" = "1" ]; then
	"$GO" test -count=1 ./...
else
	"$GO" test -count=1 -race ./...
fi

"$GO" test -count=1 -run TestSDKCoverage ./test/

echo "verify: ok"
